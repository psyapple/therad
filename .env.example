# Optional: enables Instagram post-level sync. Never commit real values.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Official public origin used by canonical URLs, sitemap, robots, and structured data.
# Example after connecting a custom domain: https://example.com
SITE_URL=

# Paste only the verification token supplied by each search service.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
