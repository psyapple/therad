# Optional: enables Instagram post-level sync. Never commit real values.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Official public origin used by canonical URLs, sitemap, robots, and structured data.
# Production default: https://saebyeokstar.com
# Use http://localhost:3000 in .env.local only when an explicit local override is needed.
SITE_URL=https://saebyeokstar.com

# Paste only the verification token supplied by each search service.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
